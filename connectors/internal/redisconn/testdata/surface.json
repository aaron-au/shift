            "password": {
              "type": "string",
              "title": "Password",
              "x-shift-secret": true
            },
            "db": {
              "type": "integer",
              "title": "Database",
              "default": 0
            },
            "tls": {
              "type": "boolean",
              "title": "Use TLS",
              "default": false
            },
            "allow_local": {
              "type": "boolean",
