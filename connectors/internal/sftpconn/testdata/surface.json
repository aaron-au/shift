              "type": "string",
              "title": "Private key (PEM)",
              "x-shift-secret": true
            },
            "host_key": {
              "type": "string",
              "title": "Host key",
              "description": "Server public key (authorized_keys line, e.g. 'ssh-ed25519 AAAA...'). Required unless allow_local."
            },
            "allow_local": {
              "type": "boolean",
              "title": "Allow local/loopback and private/internal targets (network guard off; also permits an unverified host key)",
              "default": false
            },
            "timeout_seconds": {
              "type": "integer",
              "title": "Connect timeout (seconds)",
              "default": 30
            },
            "path": {
