    "actions": [
      {
        "action": "set",
        "direction": "sink",
        "configSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "title": "Redis set",
          "required": [
            "addr"
          ],
          "properties": {
