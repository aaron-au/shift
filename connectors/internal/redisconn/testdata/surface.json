            "value_field": {
              "type": "string",
              "title": "Value field",
              "description": "Record field holding the value to store",
              "default": "value"
            },
            "ttl_seconds": {
              "type": "integer",
              "title": "TTL (seconds)",
              "description": "Optional expiry; 0 = no expiry",
